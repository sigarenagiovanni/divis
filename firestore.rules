rules_version = '2';

// Solo queste due email possono leggere e scrivere i dati di Slancio.
// Sostituisci gli indirizzi con quelli dei vostri account Google (minuscolo).
service cloud.firestore {
  match /databases/{database}/documents {
    function autorizzato() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'TUA_EMAIL@gmail.com',
          'SUA_EMAIL@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if autorizzato();
    }
  }
}
